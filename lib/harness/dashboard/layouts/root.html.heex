<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={Phoenix.Controller.get_csrf_token()} />
    <title>Harness Dashboard</title>
    <Harness.Dashboard.Tokens.stylesheet />
  </head>
  <body>
    <Harness.Dashboard.Components.page_shell>
      {@inner_content}
    </Harness.Dashboard.Components.page_shell>
    <script src="/assets/phoenix/phoenix.min.js">
    </script>
    <script src="/assets/phoenix_live_view/phoenix_live_view.min.js">
    </script>
    <script>
      const csrfToken = document.querySelector("meta[name='csrf-token']").getAttribute("content");
      const liveSocket = new LiveView.LiveSocket("/live", Phoenix.Socket, { params: { _csrf_token: csrfToken } });
      liveSocket.connect();
      window.liveSocket = liveSocket;
    </script>
  </body>
</html>
