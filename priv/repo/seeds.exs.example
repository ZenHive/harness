alias Harness.ProjectRegistry

IO.puts("""
================================================================================
PROJECT SEED SCRIPT - NOT READ AT BOOT
================================================================================

Postgres is the source of truth for project registrations.

Edit this file and run `mix harness.seed` to upsert projects, or use the live
dashboard at /harness/settings.

For a RUNNING node, prefer the dashboard or an IEx call to
Harness.ProjectRegistry.upsert/1. This script is the fresh-DB / reset path only;
editing it does nothing until you run it.
================================================================================
""")

# Keep the harness checkout itself registered. `mix precommit.full` is harness's
# own mergeable bar (precommit + dialyzer). The auto-land keys below are the
# dogfooding self-host config; drop them for a read-only registration.
:ok =
  ProjectRegistry.upsert(
    name: "harness",
    source: {:local, Path.expand("../..", __DIR__)},
    check_command: "mix precommit.full",
    languages: [:elixir],
    roadmap_path: Path.expand("../..", __DIR__),
    landing_policy: :auto,
    target_branch: "development",
    # The cron poller can dispatch a wide `rmap ready --dispatchable` batch.
    # Keep this low so concurrent self-host runs do not pile up stale-base
    # rebases and reviewer quota cliffs.
    concurrency_cap: 3
  )

# Example host-local Elixir project.
:ok =
  ProjectRegistry.upsert(
    name: "myapp",
    source: {:local, "/Users/me/_DATA/code/myapp"},
    check_command: "mix precommit",
    languages: [:elixir],
    roadmap_path: "/Users/me/_DATA/code/myapp",
    concurrency_cap: 2
  )

# Example multi-language monorepo. The check hint is free text, so name each
# component's command and where it runs; the reviewer works out the rest.
:ok =
  ProjectRegistry.upsert(
    name: "polyrepo",
    source: {:local, "/Users/me/_DATA/code/polyrepo"},
    check_command: "cd rust && cargo test; cd elixir && mix test",
    languages: [:elixir, :rust],
    roadmap_path: "/Users/me/_DATA/code/polyrepo"
  )
