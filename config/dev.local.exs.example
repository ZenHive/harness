import Config

# Per-host project registrations. Copy this file to `config/dev.local.exs`
# (gitignored) and edit. Imported from `config/dev.exs` when present.
#
# This call REPLACES the default `:projects` list from `config/dev.exs`, so
# the harness self-registration must be repeated if you want it to remain
# available. Consumed by `Harness.ProjectRegistry.init/1`.
#
# `check_command` is a free-text hint handed to the reviewer AI — the reviewer
# runs the project's checks itself and judges the result; harness never
# executes the command. Omit it to let the reviewer discover the project's
# checks on its own (mix.exs aliases, Cargo.toml, CI config, ...).
#
# `landing_policy: :auto` + `target_branch` opt a project into the autonomous
# merge-train: reviewer-approved runs ff-push to the target branch and enqueue a
# post-merge audit. Both keys are REQUIRED — a project with only one (or
# neither) boots `:manual`/`target_branch: nil`, and auto-land + audit stay off
# (the audit skips on `:no_target_branch`). These keys belong here (gitignored,
# per-host), never in the tracked `dev.exs`, so a contributor cloning harness
# doesn't silently inherit auto-push-to-origin.

config :harness, :projects, [
  # Keep the harness checkout itself registered. `mix precommit.full` is
  # harness's own mergeable bar (precommit + dialyzer). The auto-land keys below
  # are the dogfooding self-host config — drop them for a read-only registration.
  [
    name: "harness",
    source: {:local, Path.expand("..", __DIR__)},
    check_command: "mix precommit.full",
    roadmap_path: Path.expand("..", __DIR__),
    landing_policy: :auto,
    target_branch: "development"
  ],
  # Example host-local Elixir project.
  [
    name: "myapp",
    source: {:local, "/Users/me/_DATA/code/myapp"},
    check_command: "mix precommit",
    roadmap_path: "/Users/me/_DATA/code/myapp",
    concurrency_cap: 2
  ],
  # Example multi-language monorepo — the hint is free text, so name each
  # component's command and where it runs; the reviewer works out the rest.
  [
    name: "polyrepo",
    source: {:local, "/Users/me/_DATA/code/polyrepo"},
    check_command: "cd rust && cargo test; cd elixir && mix test",
    roadmap_path: "/Users/me/_DATA/code/polyrepo"
  ]
]
