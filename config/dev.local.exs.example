import Config

# Per-host project registrations. Copy this file to `config/dev.local.exs`
# (gitignored) and edit. Imported from `config/dev.exs` when present.
#
# This call REPLACES the default `:projects` list from `config/dev.exs`, so
# the harness self-registration must be repeated if you want it to remain
# available. Consumed by `Harness.ProjectRegistry.init/1`.

config :harness, :projects, [
  # Keep the harness checkout itself registered. `{:elixir_precommit, ...}`
  # mirrors harness's own `mix precommit` merge bar (coverage gate + format +
  # warnings-as-errors), so a green verdict implies a mergeable change — see
  # Task 97. Use plain `preset: :elixir` for the lighter day-to-day stack.
  [
    name: "harness",
    source: {:local, Path.expand("..", __DIR__)},
    preset: {:elixir_precommit, cover_threshold: 80, exclude: [:integration]},
    roadmap_path: Path.expand("..", __DIR__)
  ],
  # Example host-local project — single language, one stack at the repo root.
  # Swap to `preset: {:elixir_precommit, cover_threshold: N, exclude: [...]}`
  # to grade against your own merge gate instead of the lighter `:elixir` stack.
  [
    name: "myapp",
    source: {:local, "/Users/me/_DATA/code/myapp"},
    preset: :elixir,
    roadmap_path: "/Users/me/_DATA/code/myapp",
    concurrency_cap: 2
  ],
  # Example multi-language monorepo — source is the repo root; each stack runs
  # its checks in its own subdirectory via `workdir`. A git worktree is always
  # repo-root-granular, so `workdir` is how each stack reaches its buildable
  # root. Drop `stacks:` and use a singular `preset:`/`check_stack:` for the
  # single-language case (equivalent to one stack with `workdir: ""`).
  [
    name: "polyrepo",
    source: {:local, "/Users/me/_DATA/code/polyrepo"},
    roadmap_path: "/Users/me/_DATA/code/polyrepo",
    stacks: [
      [preset: :rust, workdir: "rust"],
      [preset: :elixir, workdir: "elixir"]
    ]
  ]
]
